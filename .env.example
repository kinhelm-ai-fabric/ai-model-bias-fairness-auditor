# AI Model Bias & Fairness Auditor — Environment Variables
# Copy to .env and fill in values

# Flask secret key (auto-generated if not set)
SECRET_KEY=

# Session cookie path (default: "/")
SESSION_COOKIE_PATH=/

# Data directory for SQLite DB and uploads
DATA_DIR=/app/data

# Kindo AI Agent configuration
KINDO_API_KEY=
KINDO_BIAS_AUDIT_AGENT_ID=

# Gunicorn settings
PORT=5000
WEB_CONCURRENCY=2
APP_GUNICORN_TIMEOUT=120
